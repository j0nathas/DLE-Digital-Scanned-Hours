<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistema de Gestão</title>
    <link rel="stylesheet" href="/gestao/css/login.css">
</head>
<body>
    <div class="login-container">
        <form id="login-form">
            <h2>Gestão de Produção</h2>
            <div class="input-group">
                <label for="login-input">Usuário</label>
                <input type="text" id="login-input" required>
            </div>
            <div class="input-group">
                <label for="senha-input">Senha</label>
                <input type="password" id="senha-input" required>
            </div>
            <button type="submit">Entrar</button>
            <p id="error-message" class="error-message"></p>
        </form>
        <!-- LINKS ADICIONADOS -->
        <div class="links-container">
            <a href="/gestao/register">Cadastrar novo usuário</a>
            <a href="/gestao/forgot-password">Esqueci minha senha</a>
        </div>
    </div>
    <script src="/gestao/js/login.js"></script>
</body>
</html>
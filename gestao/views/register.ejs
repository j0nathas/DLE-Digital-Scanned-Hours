<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Sistema de Gestão</title>
    <link rel="stylesheet" href="/gestao/css/login.css">
</head>
<body>
    <div class="login-container">
        <form id="register-form">
            <h2>Novo Cadastro</h2>
            <div class="input-group">
                <label for="nome-input">Nome Completo</label>
                <input type="text" id="nome-input" required>
            </div>
            <div class="input-group">
                <label for="login-input">Login de Acesso</label>
                <input type="text" id="login-input" required>
            </div>
            <div class="input-group">
                <label for="email-input">Email</label>
                <input type="email" id="email-input" value="jonathan.veloso@magna.com" required>
            </div>
             <div class="input-group">
                <label for="cargo-select">Cargo</label>
                <select id="cargo-select" required>
                    <option value="" disabled selected>Selecione um cargo</option>
                    <option value="3">Supervisor</option>
                    <option value="2">Gerente</option>
                    <option value="1">Diretor</option>
                </select>
            </div>
            
            <!-- ===================================== -->
            <!-- === CAMPO DE PLANTA ADICIONADO AQUI === -->
            <!-- ===================================== -->
            <div class="input-group">
                <label for="planta-select">Planta</label>
                <select id="planta-select" required>
                    <option value="" disabled selected>Selecione uma planta</option>
                    <!-- O value="1" corresponde ao ID da 'Planta SBC' que inserimos no banco -->
                    <option value="1">Planta SBC</option>
                </select>
            </div>

            <div class="input-group">
                <label for="senha-input">Senha</label>
                <input type="password" id="senha-input" required>
            </div>
            <button type="submit">Cadastrar</button>
            <p id="message" class="message"></p>
        </form>
        <div class="links-container">
            <a href="/gestao/login">Voltar para o Login</a>
        </div>
    </div>
    <script src="/gestao/js/register.js"></script>
</body>
</html>
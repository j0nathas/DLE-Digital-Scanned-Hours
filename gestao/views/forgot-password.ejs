<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Recuperar Senha</title>
    <link rel="stylesheet" href="/gestao/css/login.css">
</head>
<body>
    <div class="login-container">
        <div id="form-container">
            <form id="forgot-password-form">
                <h2>Recuperar Senha</h2>
                <p style="text-align: center; margin-bottom: 20px; color: #555;">Digite seu email e enviaremos um link para redefinir sua senha.</p>
                <div class="input-group">
                    <label for="email-input">Email</label>
                    <input type="email" id="email-input" value="jonathan.veloso@magna.com" required>
                </div>
                <button type="submit">Enviar Link de Recuperação</button>
                <p id="message" class="message"></p>
            </form>
        </div>
        <div id="success-container" style="display: none; text-align: center;">
            <h2>Verifique seu Email</h2>
            <p>Se uma conta com este email existir, um link de recuperação foi enviado.</p>
        </div>
        <div class="links-container">
            <a href="/gestao/login">Voltar para o Login</a>
        </div>
    </div>
    <script src="/gestao/js/forgot-password.js"></script>
</body>
</html>
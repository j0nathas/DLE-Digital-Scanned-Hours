<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Redefinir Senha</title>
    <link rel="stylesheet" href="/gestao/css/login.css">
</head>
<body>
    <div class="login-container">
        <form id="reset-password-form">
            <h2>Crie uma Nova Senha</h2>
            <!-- Campo oculto para guardar o token que vem da URL -->
            <input type="hidden" id="reset-token" value="<%= token %>">
            
            <div class="input-group">
                <label for="senha-input">Nova Senha</label>
                <input type="password" id="senha-input" required>
            </div>
            <div class="input-group">
                <label for="confirm-senha-input">Confirme a Nova Senha</label>
                <input type="password" id="confirm-senha-input" required>
            </div>
            <button type="submit">Redefinir Senha</button>
            <p id="message" class="message"></p>
        </form>
        <div class="links-container">
            <a href="/gestao/login">Voltar para o Login</a>
        </div>
    </div>
    <script src="/gestao/js/reset-password.js"></script>
</body>
</html>